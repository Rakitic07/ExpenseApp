# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# native static bundle build scratch (server files stashed during export)
/.native-build-bak/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

